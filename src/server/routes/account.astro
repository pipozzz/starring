---
import Layout from '../../components/Layout.astro';
import { getSession, instance } from '../auth';
import { getByUser } from '../profiles';
import { and, desc, eq, gt } from 'drizzle-orm';
import { db, schema } from '../db';
import { link, pageLink } from '../../lib/url';
import { ownerStats, statsConfig, type OwnerStats } from '../stats';
import { domainsEnabled, getDomain } from '../domains';
import { digestEnabled, wantsWeeklyDigest } from '../digest';

export const prerender = false;

const session = await getSession(Astro.request);
if (!session) return Astro.redirect(`${link('login')}?next=${encodeURIComponent(link('account'))}`);
const own = await getByUser(session.user.id);
const hasPassword = (await db.select({ p: schema.account.providerId }).from(schema.account).where(eq(schema.account.userId, session.user.id))).some((a) => a.p === 'credential');
const devices = await db
  .select({ token: schema.session.token, createdAt: schema.session.createdAt, ip: schema.session.ipAddress, ua: schema.session.userAgent })
  .from(schema.session)
  .where(and(eq(schema.session.userId, session.user.id), gt(schema.session.expiresAt, new Date())))
  .orderBy(desc(schema.session.createdAt));
// Visitors to your page, from the instance's Plausible — only when the operator set PLAUSIBLE_API_KEY.
let stats: OwnerStats | null | 'error' = null;
if (own?.published && statsConfig()) {
  stats = await ownerStats(pageLink(own.handle)).catch((e) => (console.error('[stats]', e.message), 'error' as const));
}
const weekly = own && digestEnabled() ? await wantsWeeklyDigest(session.user.id) : null;
const domain = own && domainsEnabled() ? await getDomain(session.user.id) : null;
const peak = stats && stats !== 'error' ? Math.max(1, ...stats.daily.map((d) => d.visitors)) : 1;
/** "Chrome on macOS" from a user agent — good enough to recognise your own devices. */
const device = (ua?: string | null) => {
  if (!ua) return 'Unknown device';
  const b = /Edg\//.test(ua) ? 'Edge' : /Firefox\//.test(ua) ? 'Firefox' : /Chrome\//.test(ua) ? 'Chrome' : /Safari\//.test(ua) ? 'Safari' : /curl|node|undici/i.test(ua) ? 'Script' : 'Browser';
  const o = /iPhone|iPad/.test(ua) ? 'iOS' : /Android/.test(ua) ? 'Android' : /Mac OS X/.test(ua) ? 'macOS' : /Windows/.test(ua) ? 'Windows' : /Linux/.test(ua) ? 'Linux' : '';
  return o ? `${b} on ${o}` : b;
};
---
<Layout title="Account — Starring" fonts={['acid']} noindex>
  <main class="acct">
    <a class="mono accent back" href={link()}>← Starring</a>
    <h1 class="display">Your<br /><span class="accent">stage.</span></h1>

    <section class="card">
      <p class="mono muted">Signed in as</p>
      <p class="big">{session.user.email} {session.user.emailVerified ? <span class="tag solid">Verified</span> : <span class="tag">Not verified</span>}</p>
      {!session.user.emailVerified && instance.mail && (
        <div class="row">
          <button class="btn ghost" id="verify" type="button" data-email={session.user.email}>Send confirmation email</button>
          <span class="muted" id="verify-status" aria-live="polite"></span>
        </div>
      )}
    </section>

    <section class="card">
      <p class="mono muted">Profile</p>
      {own ? (
        <>
          <p class="big">/{own.handle} <span class={`tag ${own.published ? 'solid' : ''}`}>{own.hidden ? 'Hidden by moderator' : own.published ? 'Published' : 'Draft'}</span></p>
          {own.hidden && <p class="warn">{own.hiddenReason} — it can't be published again. Contact the operator if you think this is a mistake.</p>}
          <p class="muted">Last saved {new Date(own.updatedAt).toLocaleString('en')}</p>
          <div class="row">
            <a class="btn" href={link('edit')}>Open editor</a>
            {own.published && <a class="btn ghost" href={link(own.handle)}>View live page ↗</a>}
          </div>
        </>
      ) : (
        <>
          <p>You haven’t claimed a handle yet.</p>
          <div class="row"><a class="btn" href={link('edit')}>Build your stage →</a></div>
        </>
      )}
    </section>

    {stats && (
      <section class="card">
        <p class="mono muted">Visitors · last {stats === 'error' ? 30 : stats.days} days</p>
        {stats === 'error' ? (
          <p class="muted">Stats aren’t available right now. Try again in a few minutes.</p>
        ) : (
          <>
            <div class="nums">
              <p><b class="display">{stats.visitors.toLocaleString('en')}</b> <span class="mono muted">visitors</span></p>
              <p><b class="display">{stats.pageviews.toLocaleString('en')}</b> <span class="mono muted">page views</span></p>
            </div>
            <svg class="spark" viewBox={`0 0 ${stats.daily.length * 10} 60`} preserveAspectRatio="none" role="img" aria-label={`Daily visitors, ${stats.daily[0].date} to ${stats.daily.at(-1)!.date}`}>
              {stats.daily.map((d, i) => (
                <rect x={i * 10 + 1} width="8" y={60 - Math.max(d.visitors ? 3 : 1, (d.visitors / peak) * 60)} height={Math.max(d.visitors ? 3 : 1, (d.visitors / peak) * 60)} class={d.visitors ? '' : 'zero'}>
                  <title>{d.date}: {d.visitors}</title>
                </rect>
              ))}
            </svg>
            {stats.visitors > 0 ? (
              <div class="tops">
                {[['Where they came from', stats.sources], ['Countries', stats.countries]].map(([label, rows]) => (
                  <div>
                    <p class="mono muted">{label as string}</p>
                    <ul>{(rows as OwnerStats['sources']).map((r) => <li><span>{r.name}</span><span class="mono">{r.visitors}</span></li>)}</ul>
                  </div>
                ))}
              </div>
            ) : (
              <p class="muted">No visitors yet — share your page on LinkedIn or put it in your GitHub profile README.</p>
            )}
          </>
        )}
      </section>
    )}

    {stats && stats !== 'error' && stats.trailer && (
      <section class="card">
        <p class="mono muted">Your trailer · last {stats.days} days</p>
        {stats.trailer.views > 0 ? (
          <>
            <div class="nums trailer-nums">
              <p><b class="display">{stats.trailer.views.toLocaleString('en')}</b> <span class="mono muted">views</span></p>
              <p><b class="display">{stats.trailer.plays.toLocaleString('en')}</b> <span class="mono muted">played</span></p>
              <p>
                <b class="display">{stats.trailer.completes.toLocaleString('en')}</b> <span class="mono muted">watched to the end</span>
                {stats.trailer.plays > 0 && <span class="mono muted"> · {Math.round((100 * stats.trailer.completes) / stats.trailer.plays)}%</span>}
              </p>
              <p><b class="display">{(stats.trailer.downloads + stats.trailer.shares).toLocaleString('en')}</b> <span class="mono muted">downloaded or shared</span></p>
            </div>
            <p class="muted">Counted on {own?.handle ? `/${own.handle}/trailer` : 'your trailer page'}. Views of a video you uploaded to LinkedIn or Instagram live in that network’s own post stats.</p>
          </>
        ) : (
          <p class="muted">Nobody has watched your trailer yet. <a href={link(`${own!.handle}/trailer/`)}>Make one</a> and post it — video travels further than a link.</p>
        )}
      </section>
    )}

    {weekly !== null && (
      <section class="card">
        <p class="mono muted">Email</p>
        <label class="check"><input type="checkbox" id="weekly" checked={weekly} /> <span>Weekly email: who visited my stage, and where they came from (Mondays)</span></label>
        <p class="muted" id="weekly-status" role="status"></p>
      </section>
    )}

    {domain && (
      <section class="card" id="domain">
        <p class="mono muted">Custom domain</p>
        {domain.domain && domain.verified ? (
          <>
            <p class="big"><a href={`https://${domain.domain}/`} target="_blank" rel="noreferrer">{domain.domain} ↗</a> <span class="tag solid">Live</span></p>
            <p class="muted">Your stage is served at the root of your domain{own?.published ? '' : ' once you publish it'}, and search engines treat it as the main address.</p>
            <div class="row"><button class="btn ghost" type="button" data-domain="remove">Remove domain</button></div>
          </>
        ) : domain.domain ? (
          <>
            <p class="big">{domain.domain} <span class="tag">Waiting for DNS</span></p>
            <p class="muted">Add these two records where you manage DNS for {domain.domain}, then press Verify. Changes can take a few minutes.</p>
            <table class="dns">
              <thead><tr><th>Type</th><th>Name</th><th>Value</th></tr></thead>
              <tbody>
                <tr><td class="mono">CNAME</td><td><code>{domain.domain}</code></td><td><code>{domain.target}</code> <button class="copy" type="button" data-copy={domain.target}>Copy</button></td></tr>
                <tr><td class="mono">TXT</td><td><code>{domain.txt!.name}</code> <button class="copy" type="button" data-copy={domain.txt!.name}>Copy</button></td><td><code>{domain.txt!.value}</code> <button class="copy" type="button" data-copy={domain.txt!.value}>Copy</button></td></tr>
              </tbody>
            </table>
            <p class="hint">A root domain (peter.dev rather than cv.peter.dev) can't have a CNAME at most providers — use ALIAS / ANAME, or Cloudflare's CNAME flattening. With Cloudflare, keep the record <b>DNS only</b> (grey cloud) so the certificate can be issued.</p>
            <div class="row">
              <button class="btn" type="button" data-domain="verify">Verify</button>
              <button class="btn ghost" type="button" data-domain="remove">Use a different domain</button>
            </div>
          </>
        ) : (
          <form class="domain-form" novalidate>
            <p class="muted">Show your stage at your own address, like <b>peter.dev</b> or <b>cv.peter.dev</b>.</p>
            <div class="row"><input name="domain" placeholder="peter.dev" autocomplete="off" spellcheck="false" aria-label="Your domain" /><button class="btn" type="submit">Connect</button></div>
          </form>
        )}
        <p class="muted" id="domain-status" role="status"></p>
      </section>
    )}

    {hasPassword && (
      <section class="card">
        <p class="mono muted">Password</p>
        <form id="pw" class="pw" novalidate>
          <input name="current" type="password" autocomplete="current-password" placeholder="Current password" required />
          <input name="next" type="password" autocomplete="new-password" placeholder="New password (10+ characters)" minlength="10" required />
          <label class="check"><input type="checkbox" name="others" checked /> Sign out my other devices</label>
          <div class="row"><button class="btn ghost" type="submit">Change password</button><span class="muted" id="pw-status" aria-live="polite"></span></div>
        </form>
      </section>
    )}

    <section class="card">
      <p class="mono muted">Signed in on {devices.length} device{devices.length === 1 ? '' : 's'}</p>
      <ul class="devices">
        {devices.map((d) => (
          <li>
            <span>{device(d.ua)}{d.token === session.session.token && <span class="tag solid">This device</span>}</span>
            <span class="muted mono">{d.createdAt.toLocaleDateString('en')}{d.ip ? ` · ${d.ip}` : ''}</span>
          </li>
        ))}
      </ul>
      <div class="row">
        {devices.length > 1 && <button class="btn ghost" id="others" type="button">Sign out other devices</button>}
        <button class="btn ghost" id="signout" type="button">Sign out</button>
      </div>
    </section>

    <section class="card">
      <p class="mono muted">Your data</p>
      <p class="muted">Everything this site stores about you — account, sign-in methods, devices, profile and reports you filed — as one JSON file. To move your profile elsewhere, use <a href={link('edit')}>Export .yaml</a> in the editor.</p>
      <div class="row"><a class="btn ghost" href="/api/me/export" download>Download my data</a></div>
    </section>

    <section class="card danger">
      <p class="mono muted">Danger zone</p>
      <p>Deleting your account removes your profile and everything stored about you on this instance. This can’t be undone.</p>
      <div class="row">
        <button class="btn ghost" id="delete" type="button">Delete account</button>
      </div>
      <p class="error" role="alert" hidden></p>
    </section>
  </main>
</Layout>

<script>
  const post = (path: string, body: object = {}) =>
    fetch(`/api/auth/${path}`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body), credentials: 'same-origin' });
  const home = document.querySelector<HTMLAnchorElement>('.back')!.href;

  document.getElementById('verify')?.addEventListener('click', async (e) => {
    const b = e.currentTarget as HTMLButtonElement;
    b.disabled = true;
    const res = await post('send-verification-email', { email: b.dataset.email, callbackURL: location.pathname });
    document.getElementById('verify-status')!.textContent = res.ok ? 'Sent — check your inbox.' : 'Could not send. Try again in a minute.';
  });

  document.getElementById('pw')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const f = new FormData(e.currentTarget as HTMLFormElement);
    const status = document.getElementById('pw-status')!;
    const newPassword = String(f.get('next') ?? '');
    if (newPassword.length < 10) { status.textContent = 'Use at least 10 characters.'; return; }
    const res = await post('change-password', { currentPassword: f.get('current'), newPassword, revokeOtherSessions: f.get('others') === 'on' });
    if (res.ok) { (e.currentTarget as HTMLFormElement).reset(); status.textContent = 'Password changed.'; return; }
    const data = await res.json().catch(() => ({}));
    status.textContent = data.message || 'Could not change the password.';
  });

  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((b) =>
    b.addEventListener('click', () => navigator.clipboard.writeText(b.dataset.copy!).then(() => { b.textContent = 'Copied'; setTimeout(() => (b.textContent = 'Copy'), 1500); })),
  );
  document.getElementById('weekly')?.addEventListener('change', async (e) => {
    const box = e.currentTarget as HTMLInputElement;
    const res = await fetch('/api/digest', { method: 'POST', headers: { 'Content-Type': 'application/json' }, credentials: 'same-origin', body: JSON.stringify({ weekly: box.checked }) });
    document.getElementById('weekly-status')!.textContent = res.ok ? (box.checked ? 'On — see you Monday.' : 'Off.') : 'Could not save — try again.';
    if (!res.ok) box.checked = !box.checked;
  });
  // custom domain: connect, verify, remove
  const domainStatus = document.getElementById('domain-status');
  const domainCall = async (method: string, body?: object) => {
    const res = await fetch('/api/domain', { method, headers: { 'Content-Type': 'application/json' }, credentials: 'same-origin', body: body ? JSON.stringify(body) : undefined });
    if (res.ok) return location.reload();
    const data = await res.json().catch(() => ({}));
    if (domainStatus) domainStatus.textContent = data.error || 'That didn’t work — try again.';
  };
  document.querySelector<HTMLFormElement>('.domain-form')?.addEventListener('submit', (e) => {
    e.preventDefault();
    domainCall('PUT', { domain: new FormData(e.currentTarget as HTMLFormElement).get('domain') });
  });
  document.querySelectorAll<HTMLButtonElement>('[data-domain]').forEach((b) =>
    b.addEventListener('click', () => {
      if (b.dataset.domain === 'remove' && !confirm('Disconnect this domain from your stage?')) return;
      if (domainStatus) domainStatus.textContent = b.dataset.domain === 'verify' ? 'Checking DNS…' : '';
      domainCall(b.dataset.domain === 'verify' ? 'POST' : 'DELETE');
    }),
  );

  document.getElementById('others')?.addEventListener('click', async () => {
    const res = await post('revoke-other-sessions');
    if (res.ok) location.reload();
  });

  document.getElementById('signout')!.addEventListener('click', async () => {
    await post('sign-out');
    location.assign(home);
  });

  document.getElementById('delete')!.addEventListener('click', async () => {
    const err = document.querySelector<HTMLElement>('.danger .error')!;
    if (!confirm('Delete your account and profile permanently?')) return;
    const res = await post('delete-user', { callbackURL: home });
    if (res.ok) return location.assign(home);
    const data = await res.json().catch(() => ({}));
    err.textContent = data.message || 'Could not delete the account. Sign in again and retry.';
    err.hidden = false;
  });
</script>

<style>
  .acct { max-width: 680px; margin: 0 auto; padding: 10vh var(--gutter); display: grid; gap: 20px; }
  .back { text-decoration: none; }
  h1 { font-size: clamp(64px, 12vw, 120px); margin-bottom: 12px; }
  .card { border: 1px solid var(--line); padding: 22px; display: grid; gap: 10px; }
  .big { font-size: 22px; font-weight: 500; display: flex; gap: 12px; align-items: center; flex-wrap: wrap; overflow-wrap: anywhere; }
  .row { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 4px; }
  .btn {
    font-family: var(--mono); text-transform: uppercase; letter-spacing: .05em; font-size: 13px;
    padding: 13px 18px; border: 0; cursor: pointer; background: var(--accent); color: var(--accent-ink); text-decoration: none;
  }
  .btn.ghost { background: transparent; color: var(--fg); box-shadow: inset 0 0 0 1px var(--line); }
  .danger { border-color: #5a1d18; }
  .danger .btn.ghost { color: #ff6b5e; box-shadow: inset 0 0 0 1px #5a1d18; }
  .error, .warn { color: #ff6b5e; }
  .card a:not(.btn) { color: var(--accent); }
  .pw { display: grid; gap: 10px; }
  .pw input[type=password] { background: transparent; border: 1px solid var(--line); color: var(--fg); font: inherit; padding: 12px; }
  .pw input:focus { outline: none; border-color: var(--accent); }
  .check { display: flex; gap: 8px; align-items: center; font-size: 14px; }
  .check input { accent-color: var(--accent); }
  .devices { list-style: none; display: grid; gap: 8px; }
  .devices li { display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; padding: 10px 0; border-bottom: 1px solid var(--line); }
  .devices .tag { margin-left: 8px; }
  .dns { width: 100%; border-collapse: collapse; font-size: 13px; }
  .dns th, .dns td { text-align: left; padding: 8px 10px 8px 0; border-bottom: 1px solid var(--line); vertical-align: top; overflow-wrap: anywhere; }
  .dns td:first-child { white-space: nowrap; }
  .dns code { font-family: var(--mono); font-size: 12px; text-transform: none; }
  .copy { font: 11px var(--mono); text-transform: uppercase; background: transparent; color: var(--accent); border: 0; cursor: pointer; padding: 0 2px; }
  .dns th { color: var(--muted); font-family: var(--mono); font-size: 11px; text-transform: uppercase; font-weight: 400; }
  .hint { font-size: 13px; color: var(--muted); }
  .domain-form input { flex: 1; min-width: 0; background: transparent; border: 1px solid var(--line); color: var(--fg); font: inherit; padding: 12px; }
  .domain-form input:focus { outline: none; border-color: var(--accent); }
  .nums { display: flex; gap: 32px; flex-wrap: wrap; }
  .nums b { font-size: 44px; font-weight: 400; color: var(--accent); margin-right: 6px; }
  .spark { width: 100%; height: 60px; display: block; }
  .spark rect { fill: var(--accent); }
  .spark rect.zero { fill: var(--line); }
  .tops { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 18px; }
  .tops ul { list-style: none; display: grid; gap: 4px; margin-top: 6px; }
  .tops li { display: flex; justify-content: space-between; gap: 12px; padding: 6px 0; border-bottom: 1px solid var(--line); }
  .trailer-nums { flex-wrap: wrap; }
</style>
