---
import '../styles/global.css';
import { themesCss, themeFontsHref, getTheme } from '../themes';
import { link } from '../lib/url';
import { publicBase } from '../lib/site';

interface Props {
  title: string;
  description?: string;
  theme?: string;
  /** BCP 47 language tag for the page (default 'en') */
  lang?: string;
  /** app pages: no progress bar or scroll effects */
  bare?: boolean;
  /** theme ids whose fonts to load; omit to load every theme (editor, gallery) */
  fonts?: (string | undefined)[];
  /** social preview image: a path inside the site ('og/nova.png') or an absolute URL */
  image?: string;
  imageAlt?: string;
  /** og:type — 'profile' on profile pages */
  type?: 'website' | 'profile';
  /** keep app pages (editor, login, account) out of search results */
  noindex?: boolean;
  /** Absolute canonical URL, when it isn't this page's own address (a stage on its custom domain). */
  canonical?: string;
  /** schema.org JSON-LD object(s) */
  jsonLd?: object | object[];
  /** oEmbed discovery URL (server mode) */
  oembed?: string;
  /** extra profile:* meta for og:type=profile */
  profileName?: { first: string; last: string; username: string };
}
const {
  title,
  description = "Developer careers as scroll stories — including the work GitHub can't show.",
  theme,
  lang = 'en',
  bare = false,
  fonts,
  image = 'og.png',
  imageAlt,
  type = 'website',
  noindex = false,
  canonical: canonicalOverride,
  jsonLd,
  oembed,
  profileName,
} = Astro.props;
const themeId = getTheme(theme).id;
// NOINDEX=true: a demo/mirror that shouldn't compete with the real site in search
const siteNoindex = () => /^(1|true|yes)$/i.test(process.env.NOINDEX ?? '');
const site = publicBase(Astro.site, Astro.url);
const canonical = canonicalOverride ?? new URL(Astro.url.pathname.replace(/\/?$/, '/'), site).href;
const imageUrl = /^https?:/.test(image) ? image : new URL(link(image), site).href;
const ld = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
// JSON-LD lives in a <script>; neutralise "</" so profile text can't close the tag.
const ldJson = (o: object) => JSON.stringify(o).replace(/</g, '\\u003c');
// Optional privacy-friendly analytics. Off unless PLAUSIBLE_SRC is set (build time for
// static sites, runtime in server mode), so forks and self-hosters never report to us.
const plausibleSrc = (() => {
  const v = process.env.PLAUSIBLE_SRC?.trim();
  return v && /^https:\/\/[^\s"'<>]+\.js$/.test(v) ? v : undefined;
})();
---
<!doctype html>
<html lang={lang} data-theme={themeId}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {(noindex || siteNoindex()) && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content={getTheme(theme).tokens.bg} />
    <link rel="icon" href={link('favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={link('apple-touch-icon.png')} />
    <link rel="sitemap" href={link('sitemap.xml')} />

    <meta property="og:site_name" content="Starring" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt ?? title} />
    {profileName && (
      <>
        <meta property="profile:first_name" content={profileName.first} />
        <meta property="profile:last_name" content={profileName.last} />
        <meta property="profile:username" content={profileName.username} />
      </>
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    {oembed && <link rel="alternate" type="application/json+oembed" href={oembed} title={title} />}
    {ld.map((o) => <script type="application/ld+json" set:html={ldJson(o)} />)}
    {plausibleSrc && (
      <>
        <script async is:inline src={plausibleSrc}></script>
        <script is:inline>
          window.plausible=window.plausible||function(){(plausible.q=plausible.q||[]).push(arguments)},plausible.init=plausible.init||function(i){plausible.o=i||{}};
          plausible.init()
        </script>
      </>
    )}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href={themeFontsHref(fonts)} rel="stylesheet" />
    <style is:inline set:html={themesCss()} />
  </head>
  <body>
    {!bare && <a class="skip-link" href="#content">Skip to content</a>}
    {!bare && <div class="progress" aria-hidden="true"></div>}
    <slot />
    <script>
      const bar = document.querySelector<HTMLElement>('.progress');
      const onScroll = () => {
        const max = document.documentElement.scrollHeight - innerHeight;
        if (bar) bar.style.transform = `scaleX(${max > 0 ? scrollY / max : 0})`;
      };
      addEventListener('scroll', onScroll, { passive: true });
      onScroll();

      const io = new IntersectionObserver(
        (entries) => entries.forEach((e) => e.isIntersecting && (e.target.classList.add('in'), io.unobserve(e.target))),
        { threshold: 0.15 }
      );
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));

      // count-up numbers
      const fmt = new Intl.NumberFormat(document.documentElement.lang || 'en');
      const counters = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (!e.isIntersecting) return;
          const el = e.target as HTMLElement;
          const to = Number(el.dataset.count);
          const t0 = performance.now();
          const tick = (t: number) => {
            const k = Math.min(1, (t - t0) / 1400);
            el.textContent = fmt.format(Math.round(to * (1 - (1 - k) ** 4)));
            if (k < 1) requestAnimationFrame(tick);
          };
          requestAnimationFrame(tick);
          counters.unobserve(el);
        });
      }, { threshold: 0.6 });
      document.querySelectorAll('[data-count]').forEach((el) => counters.observe(el));
    </script>
  </body>
</html>
