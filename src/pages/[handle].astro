---
import Layout from '../components/Layout.astro';
import ProfileStory from '../story/ProfileStory';
import ProfileAnalytics from '../components/ProfileAnalytics.astro';
import { SERVER_MODE, store, type Profile } from '../lib/profiles';
import { resolveLang } from '../lib/model';
import { link, pageLink } from '../lib/url';
import { profileDescription, profileJsonLd, profileTitle } from '../lib/seo';
import { publicBase } from '../lib/site';

// Static mode: one page per YAML profile at build time.
// Server mode: rendered on request, so new and edited DB profiles show up instantly.
export async function getStaticPaths() {
  return (await store.list()).map((p) => ({ params: { handle: p.handle }, props: { p } }));
}

let p = (Astro.props as { p?: Profile }).p;
if (SERVER_MODE) {
  p = await store.get(Astro.params.handle!);
  if (!p) return new Response(null, { status: 404, statusText: 'No such stage' });
  // browsers always re-check (an owner sees their publish at once); shared caches may hold it a minute
  Astro.response.headers.set('Cache-Control', 'public, max-age=0, must-revalidate, s-maxage=60, stale-while-revalidate=600');
}
const profile = p!;
// a verified custom domain is the stage's canonical address, wherever it's viewed
let customDomain = Astro.locals.customDomain ?? null;
if (SERVER_MODE && !customDomain && /^(1|true|yes)$/i.test(process.env.CUSTOM_DOMAINS ?? '')) {
  customDomain = await (await import('../server/domains')).domainForHandle(profile.handle);
}
const url = customDomain ? `https://${customDomain}/` : new URL(pageLink(profile.handle), publicBase(Astro.site, Astro.url)).href;
const image = new URL(link(`og/${profile.handle}.png`), publicBase(Astro.site, Astro.url)).href;
const [first, ...rest] = profile.profile.name.split(' ');
const oembed = SERVER_MODE ? `${new URL(link('oembed'), publicBase(Astro.site, Astro.url)).href}?url=${encodeURIComponent(url)}&format=json` : undefined;
---
<Layout
  title={profileTitle(profile)}
  description={profileDescription(profile)}
  theme={profile.theme}
  lang={resolveLang(profile.profile?.lang)}
  fonts={[profile.theme]}
  type="profile"
  image={image}
  imageAlt={`${profile.profile.name}, ${profile.profile.role} — Starring poster`}
  canonical={url}
  jsonLd={profileJsonLd(profile, url, image)}
  oembed={oembed}
  profileName={{ first, last: rest.join(' '), username: profile.handle }}
>
  <main id="content" tabindex="-1">
    <ProfileStory p={profile} site={Astro.locals.customDomain ? publicBase(Astro.site, Astro.url).href : undefined} />
    <a class="edit-fab mono" href={link(`edit?from=${profile.handle}`)}>Edit in Starring ✎</a>
    {SERVER_MODE && <a class="report-link mono" href={`${link('report')}?h=${profile.handle}`} rel="nofollow">Report</a>}
  </main>
  <ProfileAnalytics p={profile} />
</Layout>

<style>
  .edit-fab {
    position: fixed; right: 16px; bottom: 16px; z-index: 40;
    padding: 10px 14px; background: var(--fg); color: var(--bg); text-decoration: none;
    opacity: .0; transition: opacity .2s;
  }
  body:hover .edit-fab { opacity: .85; }
  .report-link { position: fixed; left: 16px; bottom: 16px; z-index: 40; color: var(--muted); font-size: 11px; text-decoration: none; opacity: .6; }
  .report-link:hover { opacity: 1; color: var(--fg); }
  .edit-fab:hover, .edit-fab:focus-visible { opacity: 1; }
</style>
