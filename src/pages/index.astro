---
import Layout from '../components/Layout.astro';
import ProfileStory from '../story/ProfileStory';
import ProfileAnalytics from '../components/ProfileAnalytics.astro';
import { SERVER_MODE, store, totals } from '../lib/profiles';
import { link, pageLink } from '../lib/url';
import { profileDescription, profileJsonLd, profileTitle, siteJsonLd } from '../lib/seo';
import { publicBase } from '../lib/site';
const base = publicBase(Astro.site, Astro.url);

const profiles = await store.list();
// Personal site: one profile in profiles/ → it is the home page.
const me = (await store.mode()) === 'personal' ? profiles[0] : undefined;
let signedIn = false;
let signupOpen = false;
if (SERVER_MODE) {
  const { getSession, signupOffered } = await import('../server/auth');
  signedIn = !!(await getSession(Astro.request));
  signupOpen = !signedIn && (await signupOffered());
}
---
{me ? (
<Layout title={profileTitle(me)} description={profileDescription(me)} theme={me.theme} fonts={[me.theme]} type="profile" image={`og/${me.handle}.png`} jsonLd={profileJsonLd(me, new URL(pageLink(), base).href, new URL(link(`og/${me.handle}.png`), base).href)}>
  <main><ProfileStory p={me} /></main>
  <ProfileAnalytics p={me} />
</Layout>
) : (
<Layout title="Starring — your developer career as a scroll story" description="Your developer career as a scroll story — including the client work and NDA projects GitHub can't show. Open source, free on GitHub Pages or self-hosted." jsonLd={siteJsonLd(new URL(link(), base).href)}>
  {SERVER_MODE && (
    <nav class="top mono">
      {signedIn
        ? <><a href={link('explore')}>Explore</a><a href={link('edit')}>Editor</a><a href={link('account')}>Account</a></>
        : <><a href={link('explore')}>Explore</a><a href={link('login')}>Sign in</a>{signupOpen ? <a class="accent" href={`${link('login')}?mode=signup`}>Create account</a> : <a class="accent" href={`${link('login')}?mode=request`}>Request access</a>}</>}
    </nav>
  )}
  <main>
  <header class="landing">
    <p class="mono accent brandline"><img src={link('brand/logo.svg')} alt="Starring" height="40" /><span>Open source · v0.1</span></p>
    <h1 class="display">Now<br /><span class="accent">starring</span></h1>
    <p class="pitch">
      Your GitHub shows the tip of the iceberg. Starring shows the whole career —
      the client work under NDA, the self-hosted GitLab, the school, the stack — as a scroll story.
    </p>
    <form class="gh-form" action={link('edit')} method="get">
      <label class="mono" for="gh">Your stage in 30 seconds</label>
      <div class="gh-row">
        <span class="mono">github.com/</span>
        <input id="gh" name="github" placeholder="username" required autocomplete="off" spellcheck="false" pattern="[A-Za-z0-9\-]{1,39}" />
        <button class="btn" type="submit">Build my draft →</button>
      </div>
      <p class="muted small">Reads your public profile and repos. Nothing is stored on a server.</p>
    </form>
    <div class="cta">
      <a class="btn ghost" href={link('explore')}>Explore stages →</a>
      <a class="btn ghost" href={link('edit?new')}>Start blank</a>
      <a class="btn ghost" href={link('themes')}>Browse themes</a>
      <a class="btn ghost" href="https://github.com/pipozzz/starring/generate">Use as GitHub template</a>
    </div>
  </header>

  <section class="act" id="stages">
    <div class="act-label mono"><span class="num">Now playing</span><span>{profiles.length} stages</span></div>
    <ul class="stages">
      {profiles.slice(0, 6).map((p) => {
        const t = totals(p);
        return (
          <li class="reveal" data-theme={p.theme}>
            <a href={link(p.handle)}>
              <span class="mono muted">/{p.handle}</span>
              <span class="display stage-name">{p.profile.name}</span>
              <span class="mono">{p.profile.role}</span>
              <span class="mono muted">{t.all.toLocaleString('en')} commits · {t.clients} clients · {t.privateShare}% private</span>
              <span class="arrow display">→</span>
            </a>
          </li>
        );
      })}
    </ul>
    <a class="btn explore-all" href={link('explore')}>Explore all {profiles.length} stages →</a>
  </section>

  <section class="act how">
    <div class="act-label mono"><span class="num">How</span><span>Three steps</span></div>
    <ol>
      <li class="reveal"><b class="display accent">01</b><p>Write one YAML file — or sign in with GitHub / GitLab and fill the editor.</p></li>
      <li class="reveal"><b class="display accent">02</b><p>Run the importer on your machine. It counts your commits in private repos — dates only, never code.</p></li>
      <li class="reveal"><b class="display accent">03</b><p>Get <span class="mono">starring.dev/you</span>, or self-host the static build anywhere.</p></li>
    </ol>
  </section>
  </main>
  <footer class="site-foot mono muted">
    <span>Starring — open source</span>
    <a href={link('terms')}>Terms</a>
    <a href={link('privacy')}>Privacy</a>
    <a href="https://github.com/pipozzz/starring">GitHub</a>
  </footer>
</Layout>
)}

<style>
  .top { position: absolute; top: 20px; right: var(--gutter); display: flex; gap: 20px; z-index: 5; }
  .top a { text-decoration: none; }
  .landing { min-height: 100svh; padding: max(48px, 8svh) var(--gutter); display: grid; align-content: center; gap: clamp(18px, 3.5svh, 32px); }
  /* sized by width AND height, so short laptop screens still show the form above the fold */
  .landing h1 { font-size: clamp(64px, min(15vw, 24svh), 240px); line-height: .95; }
  .pitch { font-size: clamp(18px, min(2.2vw, 3.6svh), 30px); max-width: 38ch; font-weight: 500; }
  /* wide screens: title left, pitch + form right */
  @media (min-width: 960px) {
    .landing {
      grid-template-columns: auto minmax(340px, 600px);
      grid-template-areas: 'kicker kicker' 'title pitch' 'title form' 'title cta';
      column-gap: clamp(32px, 5vw, 96px);
      align-items: end;
      justify-content: start;
    }
    .landing > .mono { grid-area: kicker; }
    .landing h1 { grid-area: title; align-self: center; font-size: clamp(72px, min(12vw, 30svh), 280px); }
    .landing .pitch { grid-area: pitch; }
    .landing .gh-form { grid-area: form; }
    .landing .cta { grid-area: cta; }
  }
  .cta { display: flex; gap: 16px; flex-wrap: wrap; }
  .brandline { display: flex; align-items: center; gap: 18px; flex-wrap: wrap; }
  .brandline img { height: 40px; width: auto; }
  .gh-form { display: grid; gap: 10px; max-width: 720px; }
  .gh-form label { color: var(--accent); }
  .gh-row { display: flex; align-items: stretch; border: 2px solid var(--fg); }
  .gh-row:focus-within { border-color: var(--accent); }
  .gh-row span { display: flex; align-items: center; padding-left: 16px; color: var(--muted); }
  .gh-row input { flex: 1; min-width: 0; background: none; border: 0; color: var(--fg); font: 500 clamp(20px, 2.4vw, 28px) var(--body); padding: 14px 4px; outline: none; }
  .gh-row .btn { border: 0; cursor: pointer; }
  .small { font-size: 14px; }
  @media (max-width: 560px) {
    .gh-row { flex-wrap: wrap; }
    .gh-row .btn { width: 100%; }
  }
  .btn {
    font-family: var(--mono); text-transform: uppercase; font-size: 14px; letter-spacing: .05em;
    padding: 16px 24px; background: var(--accent); color: var(--accent-ink); text-decoration: none;
  }
  .btn.ghost { background: transparent; color: var(--fg); border: 1px solid var(--line); }
  .btn.ghost.off { color: var(--muted); cursor: not-allowed; }
  .stages { list-style: none; display: grid; gap: 12px; }
  .explore-all { display: inline-block; margin-top: 28px; }
  .stages li { background: var(--bg); color: var(--fg); padding: 0 clamp(16px, 3vw, 40px); border: 1px solid var(--line); }
  .stages li a { border-bottom: 0; }
  .stages a {
    display: grid; grid-template-columns: 1fr auto; gap: 6px 24px; padding: 5vh 0;
    border-bottom: 1px solid var(--line); text-decoration: none;
  }
  .stages a > * { grid-column: 1; }
  .stage-name { font-size: clamp(48px, 9vw, 140px); transition: color .25s; }
  .stages a:hover .stage-name { color: var(--accent); }
  .arrow { grid-column: 2 !important; grid-row: 1 / span 4; align-self: center; font-size: clamp(48px, 8vw, 120px); color: var(--accent); transition: transform .25s; }
  .stages a:hover .arrow { transform: translateX(12px); }
  .site-foot { display: flex; gap: 20px; flex-wrap: wrap; padding: 32px var(--gutter) 48px; border-top: 1px solid var(--line); }
  .site-foot a { color: inherit; }
  .how ol { list-style: none; display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 40px; }
  .how b { font-size: 96px; display: block; }
  .how p { font-size: 20px; max-width: 30ch; }
</style>
