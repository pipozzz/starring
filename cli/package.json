{
  "name": "starring-cli",
  "version": "0.4.0",
  "description": "Local helpers for your Starring profile: count your commits in private repos, and find what GitHub knows that your stage doesn’t say yet. Nothing is uploaded.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "starring": "starring.mjs"
  },
  "files": [
    "starring.mjs",
    "scan.mjs",
    "visibility.mjs",
    "discover.mjs",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pipozzz/starring.git",
    "directory": "cli"
  },
  "homepage": "https://starring.dev",
  "keywords": [
    "git",
    "portfolio",
    "resume",
    "contributions",
    "privacy"
  ],
  "scripts": {
    "prepack": "npm --prefix .. run build:cli"
  }
}
