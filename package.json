{
  "name": "starring",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Your developer career as a scroll story. Public repos, private client work, CV — one YAML file.",
  "license": "MIT",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "new:theme": "node scripts/new-theme.mjs",
    "test": "node --import tsx --test \"src/**/*.test.ts\" \"cli/*.test.mjs\"",
    "dev:server": "STARRING_MODE=server astro dev",
    "build:server": "STARRING_MODE=server astro build",
    "start": "node scripts/migrate.mjs && node dist/server/entry.mjs",
    "db:up": "docker compose -f docker-compose.dev.yml up -d --wait",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.mjs",
    "check": "astro check",
    "check:themes": "node scripts/check-themes.mjs",
    "test:e2e": "node scripts/e2e.mjs",
    "test:a11y": "node scripts/a11y.mjs",
    "brand": "node scripts/brand.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.1.0",
    "@astrojs/node": "^11.1.9",
    "@astrojs/react": "^7.1.1",
    "@fontsource/anton": "^5.3.0",
    "@fontsource/dm-serif-display": "5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.4.2",
    "aws4fetch": "1.0.20",
    "better-auth": "^1.7.12",
    "drizzle-orm": "^0.45.4",
    "fflate": "^0.8.3",
    "mediabunny": "1.61.3",
    "nodemailer": "^10.1.7",
    "openai": "^7.40.0",
    "postgres": "^3.4.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "satori": "^0.63.2",
    "uqr": "^0.1.3",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "axe-core": "^4.14.0",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "fflate": "$fflate"
  }
}
